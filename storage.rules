rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // === VIDEO FILES ===
    match /videos/{videoId} {
      // Anyone authenticated can read videos
      allow read: if request.auth != null;
      
      // Only the uploader can write their own video
      // Assumes filename format: videos/{userId}/{videoId}.mp4
      allow write: if request.auth != null && 
                      request.resource.name.matches('videos/[^/]+/.*') &&
                      request.resource.name.split('/')[1] == request.auth.uid &&
                      request.resource.size < 100 * 1024 * 1024; // 100MB max
    }

    // === THUMBNAIL FILES ===
    match /thumbnails/{allPaths=**} {
      // Anyone can read thumbnails
      allow read: if request.auth != null;
      
      // Only backend (service account) can write thumbnails
      // This is enforced by Firebase rules, normal auth cannot access service-account-only paths
      allow write: if false; // Backend writes via service account, not client
    }

    // === AVATAR/PROFILE FILES ===
    match /avatars/{userId}/{allPaths=**} {
      // Anyone can read avatars
      allow read: if request.auth != null;
      
      // Only the user can upload their own avatar
      allow write: if request.auth != null && 
                      request.auth.uid == userId &&
                      request.resource.size < 5 * 1024 * 1024; // 5MB max for avatars
    }

    // === DENY ALL OTHER PATHS ===
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
