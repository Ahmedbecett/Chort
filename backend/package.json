{
  "name": "tokpulse-backend",
  "version": "1.0.0",
  "description": "Production Scalable Video Platform Backend for TokPulse (TikTok-style Video Streaming, Processing, Transcoding & CDN)",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && (prisma db push --skip-generate || true) && tsc",
    "vercel-build": "prisma generate && (prisma db push --skip-generate || true) && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "worker": "ts-node src/workers/video-processor.worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@prisma/client": "^5.16.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.16.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
