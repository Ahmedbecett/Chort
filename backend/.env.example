# Chort Production Server Configuration (Vercel Environment Variables)
PORT=4000
NODE_ENV=production
JWT_SECRET=replace_with_strong_production_jwt_secret_key_512bit

# PostgreSQL Database (Neon Serverless PostgreSQL via Prisma)
# Example: postgresql://USER:PASSWORD@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Cache (Optional - Upstash Redis or Redis Cloud)
REDIS_URL=

# ========================================================
# Pexels Video API (Licensed External Video Source)
# ========================================================
# Get your free API key at https://www.pexels.com/api/
# Configure this in Vercel Project Settings > Environment Variables:
PEXELS_API_KEY=

# ========================================================
# Object Storage (Cloudflare R2 / S3-Compatible)
# ========================================================
# Cloudflare R2 uses the standard S3 wire protocol:
# - S3_ENDPOINT: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# - S3_BUCKET: R2 bucket name, e.g. rivo-chort-media
# - S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: R2 API token credentials
# - S3_REGION: auto
# - S3_FORCE_PATH_STYLE: true
# R2_PUBLIC_BASE_URL is required when Stream imports the R2 object by URL.
# It can be an R2 custom domain or the bucket's public r2.dev URL.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
R2_PUBLIC_BASE_URL=

# Optional CDN or Public Delivery Base URL
CDN_BASE_URL=https://chort-nine.vercel.app

# ========================================================
# Authentication: Google / Facebook OAuth + Phone SMS (Twilio)
# Set these in Vercel Project Settings > Environment Variables.
# NEVER commit real values to git.
# ========================================================
# Google OAuth: Web client ID (must match the Android app's
# default_web_client_id so backend tokeninfo verification passes).
GOOGLE_CLIENT_ID=
# Facebook OAuth: from https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Twilio Programmable Messaging: from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: use a Messaging Service instead of a From number
TWILIO_MESSAGING_SERVICE_SID=
# Optional OTP tuning (defaults shown)
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
# Optional kill switch: set to false to NEVER echo OTP codes in API
# responses (echo only exists while Twilio is unconfigured anyway).
OTP_DEV_ECHO=auto
\n# ========================================================\n# Cloudflare Stream (video transcoding + HLS/DASH delivery)\n# Create an API Token with Stream Write permission. NEVER commit the token.\n# The backend imports the uploaded R2 object into Stream after R2 upload verification.\n# ========================================================\nCLOUDFLARE_STREAM_ACCOUNT_ID=\nCLOUDFLARE_STREAM_API_TOKEN=\n