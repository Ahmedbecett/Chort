# TokPulse Production Server Configuration (Vercel Environment Variables)
PORT=4000
NODE_ENV=production
JWT_SECRET=replace_with_strong_production_jwt_secret_key_512bit

# PostgreSQL Database (Prisma)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Cache (Optional - Upstash Redis or Redis Cloud)
REDIS_URL=

# Object Storage (AWS S3 / Cloudflare R2 / Supabase Storage / Google Cloud Storage)
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Global Content Delivery Network
CDN_BASE_URL=https://chort-nmk4.vercel.app
