# TokPulse Production Server Configuration
PORT=4000
NODE_ENV=production
JWT_SECRET=replace_with_strong_production_jwt_secret_key_512bit

# PostgreSQL Connection
DATABASE_URL=postgresql://tokpulse_admin:pulse_secure_pass@postgres:5432/tokpulse_db?schema=public

# Redis Cache & Queue
REDIS_URL=redis://redis:6379

# Object Storage (S3 / Google Cloud Storage / Cloudflare R2 / MinIO)
S3_REGION=us-east-1
S3_BUCKET=tokpulse-videos-production
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_KEY
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Global Content Delivery Network (CDN)
CDN_BASE_URL=https://cdn.tokpulse.social
