# TokPulse Production Server Configuration (Vercel Environment Variables)
PORT=4000
NODE_ENV=production
JWT_SECRET=replace_with_strong_production_jwt_secret_key_512bit

# PostgreSQL Database (Neon Serverless PostgreSQL via Prisma)
# Example: postgresql://USER:PASSWORD@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Cache (Optional - Upstash Redis or Redis Cloud)
REDIS_URL=

# ========================================================
# Object Storage (Neon Object Storage / S3-Compatible)
# ========================================================
# Neon Object Storage uses the standard S3 wire protocol:
# - S3_ENDPOINT: Your Neon Object Storage endpoint (from Neon console > Object Storage, e.g. https://storage.eu-central-1.neon.tech or branch S3 endpoint)
# - S3_BUCKET: The bucket created in Neon (e.g. tokpulse-videos)
# - S3_ACCESS_KEY_ID: Access Key ID from Neon Project credentials
# - S3_SECRET_ACCESS_KEY: Secret Access Key from Neon Project credentials
# - S3_REGION: Region of your Neon project (e.g. us-east-1, eu-central-1)
# - S3_FORCE_PATH_STYLE: true (recommended for Neon Object Storage and custom S3 endpoints)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Optional CDN or Public Delivery Base URL
CDN_BASE_URL=https://chort-nine.vercel.app
